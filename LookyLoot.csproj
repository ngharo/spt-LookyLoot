<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>LookyLoot</AssemblyName>
    <RootNamespace>LookyLoot</RootNamespace>
    <Version>1.1.1</Version>
    <SptRoot Condition="'$(SptRoot)' == ''">$(HOME)/Games/SPT-4.1</SptRoot>
    <SptManaged>$(SptRoot)/EscapeFromTarkov_Data/Managed</SptManaged>
    <SptCore>$(SptRoot)/BepInEx/core</SptCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(SptManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(SptManaged)/Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(SptManaged)/Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SptManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SptManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(SptManaged)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(SptManaged)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(SptCore)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptCore)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-reflection"><HintPath>$(SptRoot)/BepInEx/plugins/spt/spt-reflection.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- opt-in deploy so a plain build never touches the install -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(InstallPlugin)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptRoot)/BepInEx/plugins/LookyLoot" />
  </Target>

</Project>
